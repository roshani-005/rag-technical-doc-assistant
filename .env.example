# LLM Provider: "groq", "gemini", "openai", or "mock" (for offline demo/tests)
LLM_PROVIDER=groq

# Groq API Key (Free tier recommended in assignment)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Key (Alternative free tier)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Alternative)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# Embeddings: "huggingface" (offline & free, default) or "openai"
EMBEDDING_PROVIDER=huggingface

# RAG Pipeline Tuning
TOP_K=4
MAX_RETRIES=2

# Web Search Fallback (Optional)
# TAVILY_API_KEY=tvly-your-tavily-key
